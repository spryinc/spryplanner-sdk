{
  "name": "@spryinc/spryplanner-sdk",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "SpryPlanner personal-task SDK release candidate",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-LICENSES",
    "RELEASING.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "zod": "3.25.76"
  },
  "scripts": {
    "build": "node ../../build.mjs",
    "test": "vitest run src/index.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "homepage": "https://spryplanner.com/developers/docs/tools/typescript/",
  "repository": {
    "type": "git",
    "url": "https://github.com/spryinc/spryplanner-sdk.git",
    "directory": "packages/sdk-typescript"
  },
  "bugs": {
    "url": "https://github.com/spryinc/spryplanner-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  }
}
